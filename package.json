{
  "name": "osanakami-ide-studio",
  "productName": "OsanaKami IDE Studio",
  "version": "0.1.3-beta",
  "private": true,
  "description": "OsanaKami IDE Studio — a mod IDE for story-driven games",
  "license": "MIT",
  "author": "OsanaKami IDE Studio",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "cert": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make_cert.ps1",
    "pack": "node tools/sign.mjs --win --x64 --dir",
    "dist": "node tools/sign.mjs --win --x64 --dir && node tools/make-installer.mjs",
    "installer": "node tools/make-installer.mjs",
    "dist:nsis": "node tools/sign.mjs --win --x64"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.osanakami.idestudio",
    "productName": "OsanaKami IDE Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/infantgod.exe",
        "to": "infantgod.exe"
      },
      {
        "from": "shell",
        "to": "shell",
        "filter": [
          "**/*",
          "!mods/knowledge.json",
          "!mods/selftest.mjs",
          "!mods/selftest/**",
          "!web/selftest.mjs",
          "!web/selftest/**",
          "!ai/selftest.mjs",
          "!ai/selftest/**"
        ]
      },
      {
        "from": "langs",
        "to": "langs",
        "filter": [
          "**/*",
          "!selftest.mjs"
        ]
      },
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*",
          "!hello.yarn",
          "!board.json",
          "!sample.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "signtoolOptions": {
        "publisherName": "OsanaKami IDE Studio"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "EULA.txt"
    }
  }
}
