{
  "name": "infantgod-studio",
  "productName": "InfantGod Studio",
  "version": "0.1.0",
  "private": true,
  "description": "幼神工坊 — a board-shaped mod IDE for 《幼神》",
  "license": "UNLICENSED",
  "author": "InfantGod Studio",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "cert": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make_cert.ps1",
    "pack": "node tools/sign.mjs --win --x64 --dir",
    "dist": "node tools/sign.mjs --win --x64"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.infantgod.studio",
    "productName": "InfantGod Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/infantgod.exe",
        "to": "infantgod.exe"
      },
      {
        "from": "shell",
        "to": "shell"
      },
      {
        "from": "langs",
        "to": "langs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "publisherName": "InfantGod Studio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
