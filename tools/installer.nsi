; tools/installer.nsi -- the OsanaKami IDE Studio installer, compiled in ONE makensis
; pass by tools/make-installer.mjs.
;
; Why this file exists instead of electron-builder's NSIS target: that target
; compiles makensis with -DBUILD_UNINSTALLER and then EXECUTES the result so the
; installer can write out its own uninstaller.  On this machine that chained run
; pops an NSIS dialog ("Error writing temporary file.  Make sure your temp
; folder is valid.") and exits 2, so the real second pass -- the installer with
; the uninstaller embedded -- never runs.  Here WriteUninstaller embeds the
; uninstaller at build time and nothing is executed while building, so there is
; no chain to break.
;
; Every path is a -D define handed over by tools/make-installer.mjs, including
; the ownership manifest this script includes and installs; the defaults below
; are only so the file still compiles by hand from the repo root, after one
; `node tools/make-installer.mjs` has written that manifest:
;   makensis tools\installer.nsi

Unicode true
!include "MUI2.nsh"
; nsDialogs draws the shortcut page; LogicLib keeps its callbacks reading as
; conditions rather than as label arithmetic.
!include "nsDialogs.nsh"
!include "LogicLib.nsh"

; --------------------------------------------------------------------------
; Inputs (overridable with -D on the makensis command line)
; --------------------------------------------------------------------------
!ifndef APP_NAME
  !define APP_NAME "OsanaKami IDE Studio"
!endif
!ifndef APP_VERSION
  !define APP_VERSION "0.1.0"
!endif
; VIProductVersion needs four numbers, so the caller passes "0.1.0.0".
!ifndef APP_VERSION4
  !define APP_VERSION4 "0.1.0.0"
!endif
!ifndef APP_EXE
  !define APP_EXE "OsanaKami IDE Studio.exe"
!endif
!ifndef APP_ID
  !define APP_ID "com.osanakami.idestudio"
!endif
!ifndef APP_PUBLISHER
  !define APP_PUBLISHER "OsanaKami IDE Studio"
!endif
!ifndef PAYLOAD_DIR
  !define PAYLOAD_DIR "..\dist\win-unpacked"
!endif
!ifndef LICENCE_FILE
  !define LICENCE_FILE "..\EULA.txt"
!endif
!ifndef ICON_FILE
  !define ICON_FILE "..\electron\icon.ico"
!endif
!ifndef OUT_FILE
  !define OUT_FILE "..\dist\${APP_NAME} Setup ${APP_VERSION}.exe"
!endif
!ifndef UNINST_KEY
  !define UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APP_ID}"
!endif
!ifndef APP_KEY
  !define APP_KEY "Software\${APP_NAME}"
!endif
!ifndef UNINST_EXE
  !define UNINST_EXE "Uninstall ${APP_NAME}.exe"
!endif
; The ownership manifest, generated by tools/make-installer.mjs from the payload
; walk.  It compiles in the list the uninstaller may touch (G36).  The defaults
; are what a hand-run `makensis tools\installer.nsi` finds after a build.
!ifndef MANIFEST_NSI
  !define MANIFEST_NSI "..\build\install-manifest.nsi"
!endif
!ifndef MANIFEST_TXT
  !define MANIFEST_TXT "..\build\install-manifest.txt"
!endif

!include "${MANIFEST_NSI}"

; --------------------------------------------------------------------------
; Installer identity, destination, compression
; --------------------------------------------------------------------------
Name "${APP_NAME}"
OutFile "${OUT_FILE}"
; Per-user install by default; /D=... still wins for a scripted install.
InstallDir "$LOCALAPPDATA\Programs\${APP_NAME}"
RequestExecutionLevel user
; Compression: zlib.  This is not a size preference, it is the only setting that
; produces a working installer at this payload size.  Measured on this machine
; with 386,091,554 bytes of payload (127 files):
;   * SetCompressor /SOLID lzma -> NSIS aborts during startup with exit code 2
;     ("Error writing temporary file. Make sure your temp folder is valid.")
;     and installs nothing.  That is the same failure electron-builder's NSIS
;     target hits for this app.
;   * SetCompressor lzma (per-file) -> worse: exit code 0 after 1 s, no dialog,
;     nothing installed at all.
;   * SetCompressor zlib -> silent install of 129 files / 386,165,054 bytes in
;     12 s, uninstaller works and removes everything, exit code 0.
; A 439 KB payload survives /SOLID and per-file LZMA (build\tiny-solid.exe,
; build\tiny-smoke.exe), so the trigger is the payload size, not the compressor
; name.  -DLZMA=1 stays available for experiments on small payloads only.
!ifdef LZMA
  SetCompressor lzma
!else
  SetCompressor zlib
!endif

VIProductVersion "${APP_VERSION4}"
VIAddVersionKey "ProductName" "${APP_NAME}"
VIAddVersionKey "FileDescription" "${APP_NAME} Setup"
VIAddVersionKey "FileVersion" "${APP_VERSION4}"
VIAddVersionKey "ProductVersion" "${APP_VERSION}"
VIAddVersionKey "CompanyName" "${APP_PUBLISHER}"
VIAddVersionKey "LegalCopyright" "${APP_PUBLISHER}"

; --------------------------------------------------------------------------
; Look: MUI2 assisted installer
; --------------------------------------------------------------------------
!define MUI_ABORTWARNING
!define MUI_ICON "${ICON_FILE}"
!define MUI_UNICON "${ICON_FILE}"
!define MUI_FINISHPAGE_RUN "$INSTDIR\${APP_EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "Run ${APP_NAME}"

; The shortcut choices live in variables, not in the page's controls: a silent
; install never shows the page, and the install section still has to know what to
; create.  .onInit gives them their defaults; the page's leave callback overwrites
; them with what the user ticked.
Var ShortcutDialog
Var ShortcutDesktopCheck
Var ShortcutStartMenuCheck
Var ShortcutDesktop
Var ShortcutStartMenu

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${LICENCE_FILE}"
; A directory that already holds someone else's files is not ours to write into:
; the uninstaller now removes only the manifest's files, but overwriting a
; stranger's file during install is its own damage.  An upgrade (app or manifest
; already there) passes; an empty or new directory passes.
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE CheckInstallDir
!insertmacro MUI_PAGE_DIRECTORY
; Where the app is reachable from is the user's choice, so it is asked on its own
; page rather than assumed: both shortcuts are created only when ticked, and an
; upgrade that unticks one removes the shortcut the previous install made.
Page custom ShortcutPageCreate ShortcutPageLeave
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

Function CheckInstallDir
  IfFileExists "$INSTDIR\${APP_EXE}" check_dir_done
  IfFileExists "$INSTDIR\install-manifest.txt" check_dir_done
  ; IfFileExists "$INSTDIR\*.*" also matches "." and "..", so an empty folder
  ; would read as occupied.  Walk the entries instead and stop at the first real
  ; one: that is the only thing that says the folder predates this install.
  FindFirst $0 $1 "$INSTDIR\*.*"
  StrCpy $2 ""
  check_dir_loop:
    StrCmp $1 "" check_dir_close
    StrCmp $1 "." check_dir_next
    StrCmp $1 ".." check_dir_next
    StrCpy $2 $1
    Goto check_dir_close
  check_dir_next:
    FindNext $0 $1
    Goto check_dir_loop
  check_dir_close:
    FindClose $0
    StrCmp $2 "" check_dir_done
    ; Silent installs never show a page, and a MessageBox in a silent installer
    ; would block with nothing on screen to answer it: fail with NSIS's error
    ; code instead so a scripted install can tell.
    IfSilent check_dir_silent
    MessageBox MB_ICONSTOP|MB_OK "The folder$\n$\n    $INSTDIR$\n$\nwas not created by ${APP_NAME} and is not empty. Choose an empty folder, or the folder ${APP_NAME} is already installed into, so nothing that is not the app's is touched."
    Abort
  check_dir_silent:
    SetErrorLevel 2
    Abort
  check_dir_done:
FunctionEnd

; A silent install (/S) never shows the directory page, so its leave callback
; never runs: the same check also runs at startup, where $INSTDIR already holds
; the /D target.  Interactive installs run it twice, on the same directory.
Function .onInit
  Call CheckInstallDir

  ; Shortcut defaults.  A fresh install offers both.  An upgrade keeps whatever
  ; the previous install recorded, so an unticked box stays unticked across
  ; versions; a tree installed before these options existed had a Start Menu
  ; shortcut and no desktop one, which is what a missing value reads as.
  StrCpy $ShortcutDesktop "1"
  StrCpy $ShortcutStartMenu "1"
  IfFileExists "$INSTDIR\install-manifest.txt" 0 shortcut_defaults_ready
    StrCpy $ShortcutDesktop "0"
    ReadRegStr $0 HKCU "${APP_KEY}" "DesktopShortcut"
    StrCmp $0 "" +2
      StrCpy $ShortcutDesktop $0
    ReadRegStr $0 HKCU "${APP_KEY}" "StartMenuShortcut"
    StrCmp $0 "" +2
      StrCpy $ShortcutStartMenu $0
  shortcut_defaults_ready:
FunctionEnd

; The checkbox page.  MUI2 has no macro for "one page with two checkboxes", so
; this is a plain nsDialogs page inserted between the directory and install
; pages; MUI_HEADER_TEXT keeps its heading in step with the rest.
Function ShortcutPageCreate
  !insertmacro MUI_HEADER_TEXT "Choose shortcuts" "Choose where ${APP_NAME} should be easy to reach."
  nsDialogs::Create 1018
  Pop $ShortcutDialog
  ${If} $ShortcutDialog == error
    Abort
  ${EndIf}
  ${NSD_CreateCheckBox} 0 0u 100% 12u "Create a &desktop shortcut"
  Pop $ShortcutDesktopCheck
  ${NSD_SetState} $ShortcutDesktopCheck $ShortcutDesktop
  ${NSD_CreateCheckBox} 0 22u 100% 12u "Add ${APP_NAME} to the &Start Menu"
  Pop $ShortcutStartMenuCheck
  ${NSD_SetState} $ShortcutStartMenuCheck $ShortcutStartMenu
  nsDialogs::Show
FunctionEnd

Function ShortcutPageLeave
  ${NSD_GetState} $ShortcutDesktopCheck $0
  StrCpy $ShortcutDesktop $0
  ${NSD_GetState} $ShortcutStartMenuCheck $0
  StrCpy $ShortcutStartMenu $0
FunctionEnd

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "SimpChinese"

; --------------------------------------------------------------------------
; Install: lay down dist\win-unpacked verbatim, the chosen shortcuts, Add/Remove
; entry
; --------------------------------------------------------------------------
Section "!${APP_NAME}" SecInstall
  SectionIn RO
  SetShellVarContext current
  SetOutPath "$INSTDIR"
  SetOverwrite on
  File /r "${PAYLOAD_DIR}\*.*"

  ; The licence page is compiled in; the installed copy also carries the same
  ; file next to the app, so the program directory is self-describing.
  SetOutPath "$INSTDIR"
  File "${LICENCE_FILE}"

  ; The marker: what this installer laid down, in the order it was laid down.
  ; The uninstaller reads its existence before it deletes anything (G36).
  !insertmacro InstallerManifestFile

  ; Embedded here, at build time -- no second makensis pass, no self-exec.
  WriteUninstaller "$INSTDIR\${UNINST_EXE}"

  ; Shortcuts are opt-in, and the choice outlives the run: a shortcut the
  ; previous install made is removed when its box is unticked this time.  Silent
  ; installs use the .onInit defaults; the registry values let a later upgrade
  ; show those same defaults back.
  StrCmp $ShortcutStartMenu "1" shortcut_start_menu_create
    Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk"
    RMDir "$SMPROGRAMS\${APP_NAME}"
    Goto shortcut_start_menu_done
  shortcut_start_menu_create:
    CreateDirectory "$SMPROGRAMS\${APP_NAME}"
    CreateShortcut "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk" "$INSTDIR\${APP_EXE}"
  shortcut_start_menu_done:
  StrCmp $ShortcutDesktop "1" shortcut_desktop_create
    Delete "$DESKTOP\${APP_NAME}.lnk"
    Goto shortcut_desktop_done
  shortcut_desktop_create:
    CreateShortcut "$DESKTOP\${APP_NAME}.lnk" "$INSTDIR\${APP_EXE}"
  shortcut_desktop_done:

  WriteRegStr HKCU "${UNINST_KEY}" "DisplayName" "${APP_NAME}"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayVersion" "${APP_VERSION}"
  WriteRegStr HKCU "${UNINST_KEY}" "Publisher" "${APP_PUBLISHER}"
  WriteRegStr HKCU "${UNINST_KEY}" "DisplayIcon" "$INSTDIR\${APP_EXE}"
  WriteRegStr HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINST_KEY}" "UninstallString" '"$INSTDIR\${UNINST_EXE}"'
  WriteRegStr HKCU "${UNINST_KEY}" "QuietUninstallString" '"$INSTDIR\${UNINST_EXE}" /S'
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1

  WriteRegStr HKCU "${APP_KEY}" "InstallDir" "$INSTDIR"
  WriteRegStr HKCU "${APP_KEY}" "Version" "${APP_VERSION}"
  WriteRegStr HKCU "${APP_KEY}" "DesktopShortcut" "$ShortcutDesktop"
  WriteRegStr HKCU "${APP_KEY}" "StartMenuShortcut" "$ShortcutStartMenu"
SectionEnd

; --------------------------------------------------------------------------
; Uninstall: remove exactly what SecInstall created
; --------------------------------------------------------------------------
; The measured footprint is in `install-manifest.txt`, written by the installer
; and generated at build time from the payload walk.  Two rules follow:
;   * no manifest, no file deletion.  A directory without the marker is not
;     provably ours -- the old `RMDir /r "$INSTDIR"` would delete it whole --
;     so the uninstaller says why and stops at shortcuts and registry keys;
;   * with the manifest, every delete names one file, and every directory is
;     removed only once empty (`RMDir`, not `RMDir /r`).  A file the user put
;     there stops the directory's removal and is reported by its survival, not
;     deleted to make the folder go away.
Section "Uninstall"
  SetShellVarContext current
  Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME}.lnk"
  RMDir "$SMPROGRAMS\${APP_NAME}"
  ; The desktop shortcut is the same kind of thing as the Start Menu one: ours
  ; by name, gone whether or not this install happened to create it.
  Delete "$DESKTOP\${APP_NAME}.lnk"
  DeleteRegKey HKCU "${UNINST_KEY}"
  DeleteRegKey HKCU "${APP_KEY}"
  IfFileExists "$INSTDIR\install-manifest.txt" uninstall_files 0
    IfSilent uninstall_no_manifest_silent
    MessageBox MB_ICONEXCLAMATION|MB_OK "The install manifest (install-manifest.txt) is missing from$\n$\n    $INSTDIR$\n$\nso no files were removed: this folder is not provably ${APP_NAME}'s. The shortcuts and registry entries are gone; delete the folder by hand if it is yours."
    Goto uninstall_done
  uninstall_no_manifest_silent:
    SetErrorLevel 1
    Goto uninstall_done
  uninstall_files:
    !insertmacro UninstallerManifestFiles
    !insertmacro UninstallerManifestDirs
  uninstall_done:
SectionEnd
